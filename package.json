{
  "name": "@brain/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prepare": "sh scripts/prepare-hooks.sh",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:integration": "pnpm --filter @brain/test test:integration",
    "test:e2e": "pnpm --filter @brain/test test:e2e",
    "test:scenarios": "pnpm --filter @brain/test test:scenarios",
    "security:scan": "node scripts/security-scan.mjs && pnpm audit --prod --audit-level high"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "^2.0.5",
      "brace-expansion@5": "^5.0.8",
      "fast-uri": "3.1.4",
      "postcss": "8.5.24",
      "protobufjs": "7.6.5",
      "sharp": "0.35.0",
      "tar@7": "^7.5.21"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ],
    "supportedArchitectures": {
      "os": [
        "linux",
        "darwin"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "lint-staged": "17.3.0",
    "playwright": "1.62.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
