{
  "name": "@brain/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prepare": "sh scripts/prepare-hooks.sh",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:integration": "pnpm --filter @brain/test test:integration",
    "test:e2e": "pnpm --filter @brain/test test:e2e",
    "test:scenarios": "pnpm --filter @brain/test test:scenarios",
    "security:scan": "node scripts/security-scan.mjs && pnpm audit --prod --audit-level high"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "esbuild": "^0.28.1",
    "eslint": "^9.18.0",
    "lint-staged": "15.5.2",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.0.5"
  }
}
